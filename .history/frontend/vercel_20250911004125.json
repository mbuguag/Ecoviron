{
  "version": 2,
  "builds": [
    {
      "src": "frontend/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/sitemap.xml",
      "dest": "frontend/sitemap.xml"
    },
    {
      "src": "/robots.txt", 
      "dest": "frontend/robots.txt"
    },
    {
      "src": "/css/(.*)",
      "dest": "frontend/css/$1",
      "headers": {
        "Cache-Control": "public, max-age=31536000",
        "Content-Type": "text/css"
      }
    },
    {
      "src": "/js/(.*)",
      "dest": "frontend/js/$1",
      "headers": {
        "Cache-Control": "public, max-age=31536000",
        "Content-Type": "application/javascript"
      }
    },
    {
      "src": "/assets/(.*)",
      "dest": "frontend/assets/$1"
    },
    {
      "src": "/components/(.*)",
      "dest": "frontend/components/$1"
    },
    {
      "src": "/admin/(.*)",
      "dest": "frontend/admin/$1"
    },
    {
      "src": "/auth/(.*)",
      "dest": "frontend/auth/$1"
    },
    {
      "src": "/blog/(.*)",
      "dest": "frontend/blog/$1"
    },
    {
      "src": "/ecommerce/(.*)",
      "dest": "frontend/ecommerce/$1"
    },
    {
      "src": "/services/(.*)",
      "dest": "frontend/services/$1"
    },
    {
      "src": "/pages/(.*)",
      "dest": "frontend/pages/$1"
    },
    {
      "src": "/(.*\\.(html|css|js|png|jpg|jpeg|gif|svg|ico|woff|woff2|ttf|eot))",
      "dest": "frontend/$1"
    },
    {
      "src": "/",
      "dest": "frontend/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/$1"
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}