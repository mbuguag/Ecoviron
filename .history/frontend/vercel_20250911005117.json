{
  "version": 2,
  "builds": [
    {
      "src": "frontend/*.html",
      "use": "@vercel/static"
    },
    {
      "src": "frontend/components/*.html",
      "use": "@vercel/static"
    },
    {
      "src": "frontend/css/*.css",
      "use": "@vercel/static"
    },
    {
      "src": "frontend/js/**/*.js",
      "use": "@vercel/static"
    },
    {
      "src": "frontend/assets/**",
      "use": "@vercel/static"
    },
    {
      "src": "frontend/admin/**",
      "use": "@vercel/static"
    },
    {
      "src": "frontend/auth/**",
      "use": "@vercel/static"
    },
    {
      "src": "frontend/blog/**",
      "use": "@vercel/static"
    },
    {
      "src": "frontend/ecommerce/**",
      "use": "@vercel/static"
    },
    {
      "src": "frontend/services/**",
      "use": "@vercel/static"
    },
    {
      "src": "frontend/*.xml",
      "use": "@vercel/static"
    },
    {
      "src": "frontend/*.txt",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/sitemap.xml",
      "dest": "frontend/sitemap.xml",
      "headers": {
        "Cache-Control": "no-cache",
        "Content-Type": "application/xml"
      }
    },
    {
      "src": "/robots.txt",
      "dest": "frontend/robots.txt",
      "headers": {
        "Cache-Control": "public, max-age=3600",
        "Content-Type": "text/plain"
      }
    },
    {
      "src": "/css/(.*)",
      "dest": "frontend/css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "frontend/js/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "frontend/assets/$1"
    },
    {
      "src": "/components/(.*)",
      "dest": "frontend/components/$1"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/$1",
      "headers": {
        "Cache-Control": "s-maxage=3600"
      }
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "frontend/sitemap.xml" },
    { "source": "/robots.txt", "destination": "frontend/robots.txt" }
  ]
}
