{
  "version": 2,
  "builds": [
    {
      "src": "/*.html",
      "use": "@vercel/static"
    },
    
     {
      "src": "/components/*.html",
      "use": "@vercel/static"
    },
    {
      "src": "/css/*.css",
      "use": "@vercel/static"
    },
    {
      "src": "/js/**/*.js",
      "use": "@vercel/static"
    },
    {
      "src": "/assets/**",
      "use": "@vercel/static"
    },
    {
      "src": "/admin/**",
      "use": "@vercel/static"
    },
    {
      "src": "/auth/**",
      "use": "@vercel/static"
    },
    {
      "src": "/blog/**",
      "use": "@vercel/static"
    },
    {
      "src": "/ecommerce/**",
      "use": "@vercel/static"
    },
    {
      "src": "/services/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/components/(.*)",
      "dest": "/components/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/css/(.*)",
      "dest": "/css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "/js/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1",
      "headers": {
        "Cache-Control": "s-maxage=3600"
      }
    }
  ]
}