FROM nginx:alpine

# Remove default content
RUN rm -rf /usr/share/nginx/html/*

# Copy files with proper permissions
COPY . /usr/share/nginx/html/
RUN chown -R nginx:nginx /usr/share/nginx/html && \
    chmod -R 755 /usr/share/nginx/html

# Copy custom config
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Verify MIME types are properly configured
RUN grep -q "application/javascript" /etc/nginx/mime.types || \
    echo "types { application/javascript js mjs; }" > /etc/nginx/conf.d/custom_mime.types && \
    echo "include /etc/nginx/conf.d/custom_mime.types;" >> /etc/nginx/nginx.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]