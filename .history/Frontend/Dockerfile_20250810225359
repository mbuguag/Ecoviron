# 1. Use a lightweight NGINX image
FROM nginx:alpine

# 2. Remove default NGINX static assets
RUN rm -rf /usr/share/nginx/html/*

# 3. Copy our frontend files to NGINX's web root
COPY . /usr/share/nginx/html

# 4. Replace default NGINX config with ours
COPY nginx.conf /etc/nginx/conf.d/default.conf

# 5. Expose HTTP port
EXPOSE 80

# 6. Start NGINX
CMD ["nginx", "-g", "daemon off;"]
